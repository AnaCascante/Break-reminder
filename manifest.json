{
  "manifest_version": 3,
  "name": "Break Reminder",
  "version": "1.0",
  "description": "Reminds you to take a break every 20 minutes.",
  "background": {
    "service_worker": "background.js"
  },
  "default_icon": {
    "16": "assets/icons8-stretching-64.png",
    "48": "assets/icons8-wise-mind-60.png",
    "128": "assets/icons8-workspace-64.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons8-stretching-64.png",
      "48": "assets/icons8-wise-mind-60.png",
      "128": "assets/icons8-workspace-64.png"
    }
  },
  "permissions": ["notifications"]
}
