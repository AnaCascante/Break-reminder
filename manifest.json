{
  "manifest_version": 3,
  "name": "Break Reminder",
  "version": "1.0",
  "description": "Reminds you to take a break every 20 minutes.",
  "background": {
    "service_worker": "background.js"
  },
  "default_icon": {
  "16": "assets/icon16.png",
  "48": "assets/icon48.png",
  "128": "icons8-workspace-64.png"
},
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "",
      "128": "icons8-workspace-64.png"
    }
  },
  "permissions": ["notifications"]
}
